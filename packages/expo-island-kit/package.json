{
  "name": "expo-island-kit",
  "version": "0.1.0",
  "description": "Drop-in iOS Live Activities and Dynamic Island presets for Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "app.plugin.js",
    "build",
    "ios",
    "plugin",
    "!plugin/__tests__",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/ --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-island-kit",
    "ExpoIslandKit",
    "live-activities",
    "dynamic-island",
    "activitykit",
    "widgetkit",
    "ios",
    "expo-plugin"
  ],
  "repository": "https://github.com/Justdan111/islandkit",
  "bugs": {
    "url": "https://github.com/Justdan111/islandkit/issues"
  },
  "author": "Justdan111 <emmanuelngulube292@gmail.com> (https://github.com/Justdan111)",
  "license": "MIT",
  "homepage": "https://github.com/Justdan111/islandkit#readme",
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.5",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~57.0.10",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "^3.0.0",
    "react-native": "0.86.2",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/plugin"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
